#!/usr/bin/expect -f
set timeout 90
spawn /opt/homebrew/bin/gizzi-code -m local-mlx/qwen3.6-35b-a3b-4bit
log_file /tmp/gizzi-tui2.log
expect {
  -re "trust" { send "y\r"; exp_continue }
  "❯" {}
  timeout {}
}
sleep 2
send "hello\r"
expect {
  -re "Thinking|hello|Hi|Hey" { puts "\n=== saw response text ===" }
  timeout { puts "\n=== no response text seen ===" }
}
sleep 30
send "/exit\r"
sleep 2
expect eof
