#!/usr/bin/env bun
// Mock Cursor Agent CLI for ACP adapter tests.
// Implements the agent side of ACP stdio.

if (process.argv.includes("--version")) {
  console.log("1.0.0")
  process.exit(0)
}

import * as acp from "@agentclientprotocol/sdk"
import { Readable, Writable } from "node:stream"

class MockAgent {
  connection
  sessions

  constructor(connection) {
    this.connection = connection
    this.sessions = new Map()
  }

  async initialize(_params) {
    return {
      protocolVersion: acp.PROTOCOL_VERSION,
      agentCapabilities: { loadSession: false },
    }
  }

  async newSession(_params) {
    const sessionId = "sess-" + Date.now()
    this.sessions.set(sessionId, {})
    return { sessionId }
  }

  async authenticate(_params) {
    return {}
  }

  async setSessionMode(_params) {
    return {}
  }

  async prompt(params) {
    const session = this.sessions.get(params.sessionId)
    if (!session) throw new Error("Session not found")

    const promptText = params.prompt
      ?.map((part) => (part.type === "text" ? part.text : ""))
      .join("") ?? ""

    await this.connection.sessionUpdate({
      sessionId: params.sessionId,
      update: {
        sessionUpdate: "agent_message_chunk",
        content: { type: "text", text: `Mock ACP echo: ${promptText}` },
      },
    })

    await this.connection.sessionUpdate({
      sessionId: params.sessionId,
      update: {
        sessionUpdate: "usage_update",
        used: 5,
        size: 15,
      },
    })

    return { stopReason: "end_turn" }
  }

  async requestPermission(request) {
    const option =
      request.options?.find((item) => item.kind === "allow_always") ??
      request.options?.find((item) => item.kind === "allow_once") ??
      request.options?.find((item) => !String(item.kind).includes("reject"))
    return option
      ? { outcome: { outcome: "selected", optionId: option.optionId } }
      : { outcome: { outcome: "cancelled" } }
  }

  async readTextFile() {
    throw new Error("not implemented")
  }

  async writeTextFile() {
    throw new Error("not implemented")
  }
}

const stream = acp.ndJsonStream(
  Writable.toWeb(process.stdout),
  Readable.toWeb(process.stdin),
)

// eslint-disable-next-line no-new
new acp.AgentSideConnection((conn) => new MockAgent(conn), stream)
