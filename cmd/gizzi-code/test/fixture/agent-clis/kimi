#!/usr/bin/env bun
// Mock Kimi CLI for one-shot adapter tests.
// Writes a deterministic response to stdout and exits 0.

if (process.argv.includes("--version")) {
  console.log("kimi mock 1.0.0")
  process.exit(0)
}

const message = process.argv.at(-1) ?? "no prompt"
console.log(`[mock-kimi] ${message}`)
process.exit(0)
