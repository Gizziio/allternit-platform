#!/usr/bin/expect -f
set timeout 120
spawn /opt/homebrew/bin/gizzi-code -m local-mlx/qwen3.6-35b-a3b-4bit
set log [open /tmp/gizzi-tui.log w]
log_file /tmp/gizzi-tui.log
expect {
  -re "trust" { send "y\r"; exp_continue }
  -re "local-mlx" {}
  timeout {}
}
sleep 3
send "\r"
sleep 1
send "hello\r"
sleep 40
send "/exit\r"
sleep 2
expect eof
