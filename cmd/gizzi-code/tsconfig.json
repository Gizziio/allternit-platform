{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "node", "react"],
    "noUncheckedIndexedAccess": false,
    "strict": false,
    "verbatimModuleSyntax": false,

    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*", "./src/cli/ui/ink-app/*"],
      "@tui/*": ["./src/cli/ui/tui/*"],
      "@/commands/*": ["./src/cli/ui/ink-app/commands/*", "./src/commands/*"],
      "@/services/*": ["./src/cli/ui/ink-app/services/*", "./src/services/*"],
      "@/hooks/*": ["./src/cli/ui/ink-app/hooks/*", "./src/hooks/*"],
      "@/utils/*": ["./src/cli/ui/ink-app/utils/*", "./src/utils/*"],
      "@/types/*": ["./src/cli/ui/ink-app/types/*", "./src/types/*"],
      "@/components/*": ["./src/cli/ui/ink-app/components/*", "./src/components/*"],
      "@/state/*": ["./src/cli/ui/ink-app/state/*", "./src/state/*"],
      "@/bootstrap/*": ["./src/cli/ui/ink-app/bootstrap/*", "./src/bootstrap/*"],
      "@/tools/*": ["./src/cli/ui/ink-app/tools/*", "./src/tools/*"],
      "@/constants/*": ["./src/cli/ui/ink-app/constants/*", "./src/constants/*"],
      "@/core/*": ["./src/cli/ui/ink-app/core/*", "./src/core/*"],
      "@/runtime/*": ["./src/cli/ui/ink-app/runtime/*", "./src/runtime/*"],
      "@/entrypoints/*": ["./src/cli/ui/ink-app/entrypoints/*", "./src/entrypoints/*"],
      "@allternit/util": ["../../packages/@allternit/util/src"],
      "@allternit/remote-control": ["./packages/remote-control/src/index"],
      "@allternit/remote-control/*": ["./packages/remote-control/src/*"],
      "@allternit/sdk": ["./packages/sdk/src"],
      "@allternit/sdk/*": ["./packages/sdk/src/*"],
      "@allternit/sdk/providers/anthropic/error": ["./packages/sdk/src/providers/anthropic/error.ts"],
      "@allternit/sdk/providers/anthropic/resources/index.mjs": ["./packages/sdk/src/providers/anthropic/resources/index.ts"],
      "@allternit/sdk/providers/anthropic/resources/messages.mjs": ["./packages/sdk/src/providers/anthropic/resources/messages/index.ts"],
      "@allternit/sdk/providers/anthropic/resources/beta/messages/messages.mjs": ["./packages/sdk/src/providers/anthropic/resources/beta/messages/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "github/**/*",
    "packages/**/*",
    "sdks/**/*",
    "shared/**/*",
    "script/**/*"
  ],
  "exclude": [
    "dist",
    "infra",
    "node_modules",
    "output",
    "migration",
    "packages/sdk/dist"
  ]
}
