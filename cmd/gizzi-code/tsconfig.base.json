{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,
    "customConditions": [
      "browser"
    ],
    "paths": {
      "@/ink": [
        "./src/cli/ui/ink-app/ink.ts"
      ],
      "@/ink.js": [
        "./src/cli/ui/ink-app/ink.ts"
      ],
      "@/ink/*": [
        "./src/cli/ui/ink-app/ink/*"
      ],
      "@/*": [
        "./src/*",
        "./src/runtime/*",
        "./src/cli/ui/ink-app/*"
      ],
      "@tui/*": [
        "./src/cli/ui/tui/*"
      ],
      "src/*": [
        "./src/*",
        "./src/cli/ui/ink-app/*"
      ]
    }
  }
}