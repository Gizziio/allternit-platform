[Unit]
Description=Allternit Gizzi Code Daemon (always-on cron and agent runtime)
After=network.target

[Service]
Type=simple
ExecStart={{GIZZI_BINARY}} serve --hostname 127.0.0.1 --port 4096 --print-logs
Restart=always
RestartSec=10
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="GIZZI_SERVER_PASSWORD={{GIZZI_PASSWORD}}"
Environment="ALLTERNIT_API_URL={{ALLTERNIT_API_URL}}"
StandardOutput=append:/var/log/allternit-gizzi/gizzi-daemon.log
StandardError=append:/var/log/allternit-gizzi/gizzi-daemon.error.log

[Install]
WantedBy=multi-user.target
