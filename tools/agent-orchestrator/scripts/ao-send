#!/usr/bin/env bash
# ao-send — thin shim over allternit-rails orchestrator send.
# Legacy semantics: ao-send <slug> <prompt...>  or  ao-send <slug> -f <file>
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

[ $# -ge 2 ] || { echo "usage: ao-send <slug> <prompt...> | ao-send <slug> -f <file>" >&2; exit 2; }

SLUG=$1; shift
if [ "$1" = "-f" ]; then
  [ $# -eq 2 ] || { echo "usage: ao-send <slug> -f <file>" >&2; exit 2; }
  PROMPT=$(cat "$2")
else
  PROMPT="$*"
fi

exec allternit-rails orchestrator send "$SLUG" "$PROMPT"
