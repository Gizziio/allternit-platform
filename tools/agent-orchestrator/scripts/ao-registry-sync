#!/usr/bin/env bash
# ao-registry-sync — dispatch registry (A1) maintenance for the bash world.
#
#   ao-registry-sync upsert <session> <cwd> <log> <runner> <worktree:0|1> <slug> <lifecycle>
#   ao-registry-sync remove <session>
#
# state.json ({"sessions": {"ao-<slug>": {...}}}) is shared with the ao
# engine's Rust CLI. The legacy keys (cwd/log/dead) stay exactly as old
# readers expect; dispatch fields (runner, worktree, branch, sentinel, lead,
# lifecycle, world, queued) are additive and unknown fields written by newer
# tooling are preserved on upsert. Best-effort by contract: callers pipefail-
# guard it, and this script exits 0 on bad input rather than failing a spawn.
set -uo pipefail

MODE=${1:-}
case "$MODE" in
  upsert) [ $# -ge 8 ] || exit 0 ;;
  remove) [ $# -ge 2 ] || exit 0 ;;
  *) echo "usage: ao-registry-sync upsert <session> <cwd> <log> <runner> <worktree:0|1> <slug> <lifecycle> | ao-registry-sync remove <session>" >&2; exit 2 ;;
esac

exec python3 - "$HOME/.agent-orchestrator/state.json" "$MODE" "$@" <<'PY'
import json, os, sys

path, mode = sys.argv[1], sys.argv[2]
args = sys.argv[3:]
try:
    with open(path) as fh:
        state = json.load(fh)
except Exception:
    state = {}
if not isinstance(state, dict):
    state = {}
sessions = state.setdefault("sessions", {})

if mode == "remove":
    sessions.pop(args[1], None)
else:
    _mode, session, cwd, log, runner, worktree, slug, lifecycle = args[:8]
    entry = sessions.get(session) or {}
    entry.update({
        "cwd": cwd,
        "log": log,
        "dead": lifecycle != "running",
        "runner": runner,
        "lifecycle": lifecycle,
        "world": "tmux",
    })
    if worktree == "1":
        entry["worktree"] = cwd
        entry["branch"] = f"ao/{slug}"
    entry.setdefault("lead", os.environ.get("AO_LEAD") or os.environ.get("USER") or "human")
    entry.setdefault("queued", 0)
    sessions[session] = entry

os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = f"{path}.tmp"
with open(tmp, "w") as fh:
    json.dump(state, fh, indent=2)
os.replace(tmp, path)
PY
