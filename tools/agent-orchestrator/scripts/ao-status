#!/usr/bin/env bash
# ao-status — thin shim over allternit-rails orchestrator status.
# Legacy semantics: ao-status [slug] [lines=25]
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

SLUG=${1:-}
LINES=${2:-25}

if [ -z "$SLUG" ]; then
  exec allternit-rails orchestrator status
else
  exec allternit-rails orchestrator status "$SLUG" --lines "$LINES"
fi
