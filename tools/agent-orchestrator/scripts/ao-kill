#!/usr/bin/env bash
# ao-kill — thin shim over allternit-rails orchestrator kill.
# Legacy semantics: ao-kill <slug> [--rm-worktree]
# Dispatch registry (A1): drops the session record after kill.
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

[ $# -ge 1 ] || { echo "usage: ao-kill <slug> [--rm-worktree]" >&2; exit 2; }

SLUG=$1; RM_WT=${2:-}
SESSION="ao-$SLUG"
AO_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

set +e
if [ "$RM_WT" = "--rm-worktree" ]; then
  allternit-rails orchestrator kill "$SLUG" --rm-worktree
else
  allternit-rails orchestrator kill "$SLUG"
fi
rc=$?
set -e

"$AO_SCRIPTS/ao-registry-sync" remove "$SESSION" 2>/dev/null || true
exit $rc
