#!/usr/bin/env bash
# ao-watch — thin shim over allternit-rails orchestrator watch.
# Legacy semantics: ao-watch <slug> <sentinel-file> [timeout-sec=3600] [interval-sec=20]
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

[ $# -ge 2 ] || { echo "usage: ao-watch <slug> <sentinel-file> [timeout] [interval]" >&2; exit 2; }

SLUG=$1; SENTINEL=$2; TIMEOUT=${3:-3600}; INTERVAL=${4:-20}

exec allternit-rails orchestrator watch "$SLUG" "$SENTINEL" \
  --timeout-seconds "$TIMEOUT" --interval-seconds "$INTERVAL"
