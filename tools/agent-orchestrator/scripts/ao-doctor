#!/usr/bin/env bash
# ao-doctor — thin shim over allternit-rails orchestrator doctor.
# Verifies the delegation toolchain before orchestrating.
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

exec allternit-rails orchestrator doctor
