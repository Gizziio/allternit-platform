#!/usr/bin/env bash
# ao-consult [repo-dir] — thin shim over `allternit-rails steer consult`.
# Reads the steering request on stdin, prints the steering agent's answer on
# stdout. Maintains the same blocking question -> answer contract as the
# original tmux-based implementation, but uses the Rails steering coordinator
# instead of a persistent `ao-steer` session.
set -euo pipefail

command -v allternit-rails >/dev/null 2>&1 || {
  echo "error: allternit-rails is not on PATH" >&2
  exit 1
}

REPO="${1:-$PWD}"
TMPFILE=$(mktemp -t ao-consult-prompt)
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE"
[ -s "$TMPFILE" ] || { echo "ao-consult: empty request on stdin" >&2; exit 1; }

exec allternit-rails --root "$REPO" steer consult --cwd "$REPO" --prompt-file "$TMPFILE"
