{
  "version": 1,
  "policy": "New execution integrations must implement the canonical ComputerProvider or EnvironmentBackend contract.",
  "canonical_roots": [
    "providers",
    "core/environment_backends.py"
  ],
  "grandfathered_legacy_roots": [
    "adapters/browser",
    "adapters/desktop",
    "adapters/retrieval"
  ],
  "forbidden_new_patterns": [
    "adapters/**/*_adapter.py",
    "adapters/**/adapter.py"
  ]
}
