[Unit]
Description=Allternit Computer Use daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=allternit-computer serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.allternit/computer-use

[Install]
WantedBy=default.target
