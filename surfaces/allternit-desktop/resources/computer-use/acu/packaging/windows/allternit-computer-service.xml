<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>allternit-computer</id>
  <name>Allternit Computer Use</name>
  <description>Supervises the loopback-only Allternit computer-use daemon.</description>
  <executable>allternit-computer.exe</executable>
  <arguments>serve</arguments>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <stoptimeout>30 sec</stoptimeout>
  <log mode="roll-by-size"><sizeThreshold>10485760</sizeThreshold><keepFiles>5</keepFiles></log>
</service>
