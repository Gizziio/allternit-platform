# Allternit Desktop — local development environment
# Copy this file to .env.local and fill in the values.

# Auto-login with a seeded Clerk account in the auth renderer (dev only).
# Leave empty to show the normal sign-in UI.
VITE_CLERK_SEED_EMAIL=
VITE_CLERK_SEED_PASSWORD=

# Skip the runtime-pairing exchange and run against the local backend.
# Useful when you're only testing the auth renderer or local API surface.
ALLTERNIT_SKIP_PAIRING=1
