# Allternit Desktop — local development environment
# Copy this file to .env.local and fill in the values.

# Auto-login with a seeded Clerk account in the auth renderer (dev only).
# Copy the real test account from 1Password / the session/clerk-fix worktree
# .env.local, or leave empty to show the normal sign-in UI.
VITE_CLERK_SEED_EMAIL=
VITE_CLERK_SEED_PASSWORD=

# Skip the runtime-pairing exchange and run against the local backend.
# Useful when you're only testing the auth renderer or local API surface.
ALLTERNIT_SKIP_PAIRING=1

# The Clerk publishable key is baked into resources/company.json and written to
# dist/renderer/auth/clerk-config.json at build time. To override it for a
# single build, set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in your shell.

