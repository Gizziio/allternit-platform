{
  "name": "@allternit/desktop",
  "version": "1.0.0",
  "description": "Allternit Desktop — Electron shell loading the Allternit platform with local VM management via Apple Virtualization.framework.",
  "main": "dist/main/unified-main.js",
  "type": "module",
  "keywords": [
    "allternit",
    "desktop",
    "electron"
  ],
  "scripts": {
    "dev": "npm run build:auth-renderer && NODE_ENV=development electron .",
    "dev:auth-renderer": "vite --config vite.auth-renderer.config.ts --port 5174",
    "prepare:platform-static": "node scripts/prepare-platform-static.cjs",
    "prepare:office-addins": "ALLTERNIT_OFFICE_APP_BASE_URL=https://ai.allternit.com/office-addins ALLTERNIT_PLATFORM_URL=https://ai.allternit.com pnpm --dir ../allternit-extensions/allternit-office-addin manifest:generate",
    "prepare:cua-driver": "node scripts/prepare-cua-driver.cjs",
    "prepare:mesh-node": "node scripts/prepare-mesh-node.cjs",
    "prepare:office-engine": "node scripts/prepare-office-engine.cjs",
    "build": "npm run build:auth-renderer && npm run build:main && npm run build:preload",
    "build:auth-renderer": "node scripts/build-auth-renderer.cjs",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:preload": "tsc -p src/preload/tsconfig.json",
    "download:lima": "node scripts/download-lima.cjs",
    "config:company": "cd ../.. && pnpm run config:company:write",
    "build:electron": "npm run config:company && npm run prepare:platform-static && npm run prepare:office-addins && npm run prepare:cua-driver && npm run download:lima && npm run prepare:mesh-node && npm run prepare:office-engine && npm run build && electron-builder --mac",
    "build:electron:dmg": "npm run config:company && npm run prepare:platform-static && npm run prepare:office-addins && npm run prepare:cua-driver && npm run download:lima && npm run prepare:mesh-node && npm run prepare:office-engine && npm run build && electron-builder --mac dmg",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/preload/tsconfig.json",
    "test:e2e": "pnpm run build && playwright test",
    "pack": "npm run prepare:platform-static && npm run prepare:office-addins && npm run prepare:cua-driver && npm run prepare:mesh-node && npm run prepare:office-engine && electron-builder --dir",
    "dist": "npm run prepare:platform-static && npm run prepare:office-addins && npm run prepare:cua-driver && npm run prepare:mesh-node && npm run prepare:office-engine && npm run build && electron-builder"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.30.0",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "fix-path": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "update-electron-app": "^3.0.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.58.2",
    "@types/electron-store": "^1.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.1",
    "wait-on": "^8.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Allternit",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/allternit/desktop"
  },
  "build": {
    "appId": "com.allternit.desktop",
    "productName": "Allternit Desktop",
    "protocols": [
      {
        "name": "Allternit Protocol",
        "schemes": [
          "allternit"
        ]
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "copyright": "Copyright © 2026 Allternit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "static/**/*",
      "!build/entitlements*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/platform/",
        "to": "platform/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/lima/",
        "to": "lima/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/computer-use/",
        "to": "computer-use/",
        "filter": [
          "cua-driver",
          "VERSION.json",
          "README.md",
          "LICENSE.cua-driver.txt"
        ]
      },
      {
        "from": "resources/office-engine/",
        "to": "office-engine/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/office-engine/node_modules",
        "to": "office-engine/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../resources/company.json",
        "to": "company.json"
      },
      {
        "from": "../../cmd/gizzi-code/src/runtime/vm/allternit.yaml",
        "to": "allternit.yaml"
      },
      {
        "from": "../../services/open-connector",
        "to": "connector-sidecar",
        "filter": [
          "src/**/*",
          "catalog/**/*",
          "migrations/**/*",
          "package.json",
          "!**/*.test.ts",
          "!data/**"
        ]
      },
      {
        "from": "../../services/open-connector/node_modules",
        "to": "connector-sidecar/node_modules",
        "filter": [
          "**/*",
          "!.bin"
        ]
      },
      {
        "from": "../allternit-extensions/allternit-office-addin/manifests/",
        "to": "office-addins/manifests/",
        "filter": [
          "*.xml"
        ]
      }
    ],
    "asarUnpack": [
      "resources/bin/**",
      "resources/lima/**"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "description": "Microsoft Word document",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "description": "Microsoft Excel workbook",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint presentation",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Portable Document Format file",
        "role": "Viewer"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown text file",
        "role": "Viewer"
      },
      {
        "ext": "doc",
        "name": "Word 97-2003 Document",
        "description": "Legacy Microsoft Word document",
        "role": "Viewer"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Workbook",
        "description": "Legacy Microsoft Excel workbook",
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "binaries": [
        "Contents/Resources/computer-use/cua-driver"
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Allternit uses automation to carry out computer-use actions you approve."
      }
    },
    "dmg": {
      "title": "Allternit ${version}",
      "icon": "build/icon.icns",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 200,
          "name": "Allternit Desktop.app"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "internetEnabled": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Your AI Platform",
      "description": "Allternit Desktop — fully offline AI platform with local VM execution."
    },
    "appImage": {
      "artifactName": "Allternit-${version}.AppImage"
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional",
      "compression": "xz"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": "Allternit"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "shortcutName": "Allternit",
      "menuCategory": "Allternit",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "artifactName": "Allternit-Setup-${version}.exe",
      "license": "build/LICENSE.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gizziio",
        "repo": "desktop",
        "releaseType": "release"
      }
    ],
    "afterSign": "scripts/notarize.cjs",
    "artifactName": "Allternit-Desktop-${version}-${arch}.${ext}"
  }
}
