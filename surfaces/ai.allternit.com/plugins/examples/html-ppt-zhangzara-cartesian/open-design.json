{
  "id": "html-ppt-zhangzara-cartesian",
  "name": "Cartesian Deck",
  "version": "1.0.0",
  "description": "Quiet warm-neutral 16:9 HTML deck with classical Playfair serifs — investment theses, white papers, advisory and longform research.",
  "category": "examples",
