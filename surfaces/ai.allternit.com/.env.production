# Production build env — baked into the static JS bundle at build time.
# Vite exposes VITE_* prefixed vars to the browser bundle.
# NEVER put secret keys here.

# Clerk — enabled for production
VITE_ALLTERNIT_PLATFORM_DISABLE_CLERK=0
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYWxsdGVybml0LmNvbSQ
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/shell
VITE_CLERK_AFTER_SIGN_UP_URL=/shell

# Legacy fallbacks (migration period)
NEXT_PUBLIC_ALLTERNIT_PLATFORM_DISABLE_CLERK=0
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYWxsdGVybml0LmNvbSQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/shell
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/shell

# Allternit cloud API / gateway endpoints
VITE_ALLTERNIT_GATEWAY_URL=https://api.allternit.com
NEXT_PUBLIC_ALLTERNIT_GATEWAY_URL=https://api.allternit.com
NEXT_PUBLIC_ALLTERNIT_CLOUD_API_URL=https://api.allternit.com
