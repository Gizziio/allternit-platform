# Production build env — baked into the static JS bundle at build time.
# Vite exposes VITE_* prefixed vars to the browser bundle.
# NEVER put secret keys here.

# Clerk — enabled for production
VITE_ALLTERNIT_PLATFORM_DISABLE_CLERK=0
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYWxsdGVybml0LmNvbSQ
VITE_CLERK_SIGN_IN_URL=https://platform.allternit.com/sign-in
VITE_CLERK_SIGN_UP_URL=https://platform.allternit.com/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=https://remotecontrol.allternit.com
VITE_CLERK_AFTER_SIGN_UP_URL=https://remotecontrol.allternit.com

# Legacy fallbacks (migration period)
NEXT_PUBLIC_ALLTERNIT_PLATFORM_DISABLE_CLERK=0
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYWxsdGVybml0LmNvbSQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://platform.allternit.com/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://platform.allternit.com/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=https://remotecontrol.allternit.com
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=https://remotecontrol.allternit.com
# Remote Control production endpoints
NEXT_PUBLIC_ALLTERNIT_CLOUD_API_URL=https://api.allternit.com
NEXT_PUBLIC_ALLTERNIT_GATEWAY_URL=https://api.allternit.com
VITE_ALLTERNIT_GATEWAY_URL=https://api.allternit.com
NEXT_PUBLIC_ALLTERNIT_PUSH_WORKER_URL=https://allternit-remote-control-push.allternitpbc.workers.dev

# Clerk Frontend API proxy — routes FAPI through allternit.com so session
# cookies are first-party and robust against third-party cookie blocking.
NEXT_PUBLIC_CLERK_PROXY_URL=https://allternit.com/__clerk

# Clerk routing (from desktop-cloud-mvp merge)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/shell
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/shell
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/shell
VITE_CLERK_AFTER_SIGN_UP_URL=/shell
