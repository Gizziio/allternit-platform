# Allternit Platform — Environment Variables
# Copy this file to .env.local and fill in the values.
# For packaged apps, most company-level values are baked into resources/company.json
# by `pnpm config:company:write`. End users should only need to configure their brain.

# =============================================================================
# REQUIRED: Database (SQLite path for desktop/web builds)
# =============================================================================
DATABASE_URL="file:./app.db"

# =============================================================================
# AUTH: Clerk (production / multi-user hosted mode)
# Set these when ALLTERNIT_SELF_HOSTED=false and you want Clerk auth.
# Get keys from: https://dashboard.clerk.com
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_live_YOUR_KEY_HERE
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# =============================================================================
# AUTH: Self-hosted mode (single-user / packaged app)
# When true, Clerk is optional and the local bundle/desktop headers are trusted.
# =============================================================================
ALLTERNIT_SELF_HOSTED=true

# =============================================================================
# REQUIRED: Encryption Key for local-at-rest secrets
# Generate with: openssl rand -hex 32
# =============================================================================
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# =============================================================================
# OPTIONAL: Service URLs (defaults are fine for local development)
# =============================================================================
NEXT_PUBLIC_ALLTERNIT_GATEWAY_URL=http://localhost:8013
ALLTERNIT_API_PORT=8013
TERMINAL_SERVER_URL=http://127.0.0.1:4096
ALLTERNIT_RAILS_URL=http://127.0.0.1:8080
ALLTERNIT_RAILS_WORKSPACE_ID=default
ALLTERNIT_CRON_DAEMON_URL=http://127.0.0.1:4096/cron

# Cloudflare worker that receives Web Push subscriptions and relays them to
# paired runtimes. Optional: when unset, push notifications are disabled.
NEXT_PUBLIC_ALLTERNIT_PUSH_WORKER_URL=

# =============================================================================
# OPTIONAL: Development helpers
# =============================================================================
# Bypass Clerk JWT verification for local API development. NEVER use in production.
ALLTERNIT_LOCAL_DEV_BYPASS=true

# Default model provider/model pair used when no provider is configured.
ALLTERNIT_DEFAULT_MODEL=kimi-for-coding/kimi-k2

# =============================================================================
# OPTIONAL: Provider API keys (can also be configured via the onboarding wizard)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=...

# =============================================================================
# OPTIONAL: Swarm Sandbox Tier (E2B)
# Get a key from: https://e2b.dev/dashboard
# =============================================================================
E2B_API_KEY=

