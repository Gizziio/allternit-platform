# Allternit Platform — Environment Variables
# Copy this file to .env.local and fill in the values.
# For packaged apps, most company-level values are baked into resources/company.json
# by `pnpm config:company:write`. End users should only need to configure their brain.

# =============================================================================
# REQUIRED: Database (SQLite path for desktop/web builds)
# =============================================================================
DATABASE_URL="file:./app.db"

# =============================================================================
# AUTH: Clerk (production / multi-user hosted mode)
# Set these when ALLTERNIT_SELF_HOSTED=false and you want Clerk auth.
# The production instance uses the custom domain clerk.allternit.com.
# Get keys from: https://dashboard.clerk.com
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_live_YOUR_KEY_HERE
CLERK_JWKS_URL=https://clerk.allternit.com/.well-known/jwks.json
CLERK_ISSUER=https://clerk.allternit.com
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Proxy Clerk's Frontend API through the app's own origin. This makes Clerk
# cookies first-party, which is required on browsers that block third-party
# cookies across subdomains (Chrome 3pcd, Safari ITP, Playwright headless).
# Leave empty to use Clerk's configured Frontend API directly.
NEXT_PUBLIC_CLERK_PROXY_URL=

# =============================================================================
# AUTH: Self-hosted mode (single-user / packaged app)
# When true, Clerk is optional and the local bundle/desktop headers are trusted.
# =============================================================================
ALLTERNIT_SELF_HOSTED=true

# =============================================================================
# REQUIRED: Encryption Key for local-at-rest secrets
# Generate with: openssl rand -hex 32
# =============================================================================
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# =============================================================================
# OPTIONAL: Service URLs (defaults are fine for local development)
# =============================================================================
NEXT_PUBLIC_ALLTERNIT_GATEWAY_URL=http://localhost:8013
ALLTERNIT_API_PORT=8013
TERMINAL_SERVER_URL=http://127.0.0.1:4096
ALLTERNIT_RAILS_URL=http://127.0.0.1:8080
ALLTERNIT_RAILS_WORKSPACE_ID=default
ALLTERNIT_CRON_DAEMON_URL=http://127.0.0.1:4096/cron

# Cloudflare worker that receives Web Push subscriptions and relays them to
# paired runtimes. Optional: when unset, push notifications are disabled.
VITE_REMOTE_CONTROL_PUSH_URL=

# =============================================================================
# OPTIONAL: Development helpers
# =============================================================================
# Bypass Clerk JWT verification for local API development. NEVER use in production.
ALLTERNIT_LOCAL_DEV_BYPASS=true

# Agent / development auth — use the production test account.
#
# When VITE_CLERK_SEED_EMAIL and VITE_CLERK_SEED_PASSWORD are set, the local
# Vite dev server (`pnpm dev`) automatically signs in as that user on startup.
# This lets agents build and test features without manually signing in every
# time the page reloads.
#
# Copy this file to .env.local and fill in the password. The password is shared
# in this worktree's .env.local; never commit it.
#
#   cp .env.example .env.local
#
# Production test account:
#   Email:    cartlidge.joseph@yahoo.com
#   Password: <see .env.local or ask the session lead>
VITE_CLERK_SEED_EMAIL=cartlidge.joseph@yahoo.com
VITE_CLERK_SEED_PASSWORD=

# End-to-end Clerk smoke test credentials. These are read by
# `tests/clerk-e2e.spec.ts`, `scripts/clerk-e2e-verify.mjs`, and
# `scripts/clerk-stress-test-v4.mjs`. The scripts auto-load .env.local via
# dotenv, so you can run them without passing credentials on the command line.
CLERK_TARGET_ORIGIN=https://platform.allternit.com
CLERK_SECONDARY_ORIGIN=https://ai.allternit.com
CLERK_TEST_EMAIL=cartlidge.joseph@yahoo.com
CLERK_TEST_PASSWORD=
CLERK_SECONDARY_EMAIL=
CLERK_SECONDARY_PASSWORD=

# Default model provider/model pair used when no provider is configured.
ALLTERNIT_DEFAULT_MODEL=kimi-for-coding/kimi-k2

# =============================================================================
# OPTIONAL: Provider API keys (can also be configured via the onboarding wizard)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=...

# =============================================================================
# OPTIONAL: Swarm Sandbox Tier (E2B)
# Get a key from: https://e2b.dev/dashboard
# =============================================================================
E2B_API_KEY=

