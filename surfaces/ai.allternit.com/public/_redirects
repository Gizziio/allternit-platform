# Cloudflare Pages follows _redirects rules even when a static asset exists at
# the requested path, and only the first matching rule applies. Static files
# must therefore be listed here explicitly (self-rewrite to pass through), or
# the SPA catch-all at the bottom will swallow them and serve index.html.
/_next/static/* /_next/static/:splat 200
/assets/* /assets/:splat 200
/images/* /images/:splat 200
/editions/* /editions/:splat 200
/.well-known/* /.well-known/:splat 200
/favicon.svg /favicon.svg 200
/remote-control.html /remote-control.html 200
/remote-control-service-worker.js /remote-control-service-worker.js 200
/remote-control.webmanifest /remote-control.webmanifest 200
/manifest.json /manifest.json 200
/sw.js /sw.js 200
/robots.txt /robots.txt 200
/404.html /404.html 200
/bonsai-webgpu-worker.js /bonsai-webgpu-worker.js 200
/benchmarks/* /benchmarks/:splat 200
/desktop-cloud-admin.html /desktop-cloud-admin.html 200
/desktop-cloud-admin.js /desktop-cloud-admin.js 200
/plugin-manager-demo.html /plugin-manager-demo.html 200
/remote-control-icon-192.png /remote-control-icon-192.png 200
/remote-control-icon-512.png /remote-control-icon-512.png 200
/remote-control-splash-1170x2532.png /remote-control-splash-1170x2532.png 200
/icons/* /icons/:splat 200
/brand/* /brand/:splat 200
/fonts/* /fonts/:splat 200
/videos/* /videos/:splat 200
/demos/* /demos/:splat 200
/design-systems/* /design-systems/:splat 200
/skills/* /skills/:splat 200

# Generated by deploy-cloudflare-pages.yml (copied into public/ pre-build).
# Without this pass-through the Discovery feed returns SPA HTML (text/html).
/discovery-feed.json /discovery-feed.json 200

# Clerk auth sub-path routing (exact match + sub-paths)
/sign-in /sign-in 200
/sign-in/* /sign-in 200
/sign-up /sign-up 200
/sign-up/* /sign-up 200

# Shell sub-routes
/shell /shell 200
/shell/* /shell 200

# Other app routes that must not fall through to root (would trigger AuthGate loop)
/connect /connect 200
/connect/* /connect 200

# SPA fallback (rewrite to root path, not /index.html, to avoid CF loop detection)
/* / 200
