# Build-time environment variables for the Office add-in.
# Copy this file to .env and fill in the values.
# These are baked into the bundle at build time — they are NOT loaded at runtime.

# REQUIRED: Origin of the Allternit API gateway (Rust backend)
# Example: https://api.allternit.com
VITE_ALLTERNIT_GATEWAY_URL=http://127.0.0.1:8013

# REQUIRED: Origin of the Allternit platform web app (shell)
# Example: https://app.allternit.com
VITE_ALLTERNIT_PLATFORM_URL=http://localhost:3013

# OPTIONAL: Base URL where the add-in files are hosted.
# Defaults to https://localhost:3000 if dev certs exist, otherwise http://localhost:3000
# For production, this must be an HTTPS CDN origin:
# ALLTERNIT_OFFICE_APP_BASE_URL=https://addin.allternit.com

# OPTIONAL: Stable GUID for the add-in manifest.
# Generate once with: node -e "console.log(require('crypto').randomUUID())"
# If omitted, a new random GUID is generated on every build (fine for dev, bad for production)
# ALLTERNIT_OFFICE_APP_GUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OPTIONAL: Display metadata
# ALLTERNIT_OFFICE_DISPLAY_NAME=Allternit
# ALLTERNIT_OFFICE_DESCRIPTION=AI-powered task pane for Excel, PowerPoint, and Word
# ALLTERNIT_SUPPORT_URL=https://allternit.com
# ALLTERNIT_OFFICE_PROVIDER_NAME=Allternit
