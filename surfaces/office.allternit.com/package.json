{
  "name": "@allternit/office-surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Allternit Office — standalone web surface for Docs, Sheets, Slides, PDF, and Sign",
  "scripts": {
    "dev": "vite --port 3015",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview --port 3015",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allternit/allternit-office-suite": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
