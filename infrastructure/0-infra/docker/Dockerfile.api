FROM rust:1.78-slim AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY packages ./packages

RUN cargo build -p allternit-api --release

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m allternit
WORKDIR /app

COPY --from=builder /app/target/release/allternit-api /usr/local/bin/allternit-api

RUN mkdir -p /data \
    && chown -R allternit:allternit /data

USER allternit

ENV Allternit_API_BIND=0.0.0.0:3000 \
    Allternit_LEDGER_PATH=/data/allternit.jsonl \
    Allternit_DB_PATH=/data/allternit.db \
    Allternit_API_IDENTITY=api-service \
    Allternit_API_TENANT=default \
    Allternit_API_BOOTSTRAP_POLICY=true \
    Allternit_API_POLICY_ENFORCE=true

EXPOSE 3000

CMD ["allternit-api"]
