Allternit_API_BIND=0.0.0.0:3000
Allternit_LEDGER_PATH=/data/allternit.jsonl
Allternit_DB_PATH=/data/allternit.db
Allternit_API_IDENTITY=api-service
Allternit_API_TENANT=default
Allternit_API_BOOTSTRAP_POLICY=true
Allternit_API_POLICY_ENFORCE=true

# Chrome Streaming Gateway
TURN_SECRET=change-this-secret-in-production
TURN_REALM=allternit.io

# Public origin where allternit-api is reachable. Used for OAuth redirect URIs
# (both the Rust-native curated-connector callback and the open-connector
# sidecar callback). Must match OOMOL_CONNECT_ORIGIN on the sidecar.
ALLTERNIT_PUBLIC_BASE_URL= # e.g. https://ai.example.com or http://127.0.0.1:8013 for local dev

# open-connector sidecar (services/open-connector) — vendored self-hosted
# OAuth connector gateway, bound to 127.0.0.1 only, proxied via allternit-api
ALLTERNIT_CONNECTOR_SIDECAR_PORT=8014 # services/open-connector (Node sidecar)
ALLTERNIT_CONNECTOR_SIDECAR_ADMIN_TOKEN= # optional — auto-generated per dev session by scripts/dev-stack-watch.cjs if unset
ALLTERNIT_CONNECTOR_SIDECAR_RUNTIME_TOKEN= # optional — auto-generated per dev session by scripts/dev-stack-watch.cjs if unset
# ENCRYPTION_KEY is also shared with the sidecar as OOMOL_CONNECT_ENCRYPTION_KEY
# (one secret drives both allternit-api token_crypto.rs and the sidecar vault)
#
# Google OAuth: run scripts/setup-google-oauth.sh after the sidecar is running.
# It registers Gmail + Google Drive client credentials in the sidecar vault.

# Agent email rail (services/mailflare) — vendored mailflare fork deployed to
# the installing user's own Cloudflare account by services/mailflare/setup.sh
ALLTERNIT_MAILFLARE_URL= # e.g. https://allternit-agent-mail.<subdomain>.workers.dev
ALLTERNIT_MAILFLARE_ADMIN_KEY= # admin-scope API key (ep_...), printed once by setup.sh
ALLTERNIT_BOT_EMAIL_DOMAIN= # e.g. agents.example.com — per-agent mailboxes live here
ALLTERNIT_MAILFLARE_WEBHOOK_SECRET= # HMAC secret verifying message.inbound webhooks

# Remote Control push worker (Cloudflare Workers)
# VAPID_JWK and VAPID_PUBLIC_KEY are generated by the worker setup script.
ALLTERNIT_REMOTE_CONTROL_PUSH_URL= # e.g. https://push.remotecontrol.example.com
ALLTERNIT_REMOTE_CONTROL_NOTIFY_SECRET= # shared secret for /notify (or device-token auth in local dev)
# Cloud API URL used by the push worker to verify Clerk-owned runtimes and device tokens.
ALLTERNIT_CLOUD_API_URL= # e.g. https://cloud-api.example.com
