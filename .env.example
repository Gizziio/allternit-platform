Allternit_API_BIND=0.0.0.0:3000
Allternit_LEDGER_PATH=/data/allternit.jsonl
Allternit_DB_PATH=/data/allternit.db
Allternit_API_IDENTITY=api-service
Allternit_API_TENANT=default
Allternit_API_BOOTSTRAP_POLICY=true
Allternit_API_POLICY_ENFORCE=true

# Chrome Streaming Gateway
TURN_SECRET=change-this-secret-in-production
TURN_REALM=allternit.io

# open-connector sidecar (services/open-connector) — vendored self-hosted
# OAuth connector gateway, bound to 127.0.0.1 only, proxied via allternit-api
ALLTERNIT_CONNECTOR_SIDECAR_PORT=8014 # services/open-connector (Node sidecar)
ALLTERNIT_CONNECTOR_SIDECAR_ADMIN_TOKEN= # optional — auto-generated per dev session by scripts/dev-stack-watch.cjs if unset
ALLTERNIT_CONNECTOR_SIDECAR_RUNTIME_TOKEN= # optional — auto-generated per dev session by scripts/dev-stack-watch.cjs if unset
# ENCRYPTION_KEY is also shared with the sidecar as OOMOL_CONNECT_ENCRYPTION_KEY
# (one secret drives both allternit-api token_crypto.rs and the sidecar vault)
