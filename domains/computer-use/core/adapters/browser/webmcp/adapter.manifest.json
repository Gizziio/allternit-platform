{
  "adapter_id": "browser.webmcp",
  "display_name": "WebMCP Site Tools Adapter",
  "version": "0.1.0",
  "family": "browser",
  "pattern": "deterministic",
  "modes_supported": ["execute", "inspect"],
  "capability_classes": ["deterministic-web"],
  "traits": {
    "headed": "yes",
    "headless": "yes",
    "parallel": "partial",
    "persistent_session": "yes",
    "visual_reasoning": "no",
    "low_level_debug": "partial",
    "checkpointable": "partial",
    "current_session_attach": "yes",
    "artifact_handoff": "no",
    "network_inspection": "no",
    "multi_tab": "yes",
    "file_upload": "no",
    "file_download": "no"
  },
  "guarantees": {
    "semantic": "B",
    "policy": "A",
    "receipt": "B",
    "conformance": "C",
    "routing_confidence": "C"
  },
  "production_status": "experimental",
  "policy_profile": "plugin-gated",
  "risk_level": "medium",
  "conformance_suite": "browser-deterministic-v1",
  "fallback_rank": 30,
  "default_for_modes": [],
