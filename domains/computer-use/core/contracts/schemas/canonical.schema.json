{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.allternit.com/computer-use/canonical-1.0.0-alpha.1.json",
  "title": "Allternit Canonical Computer Use Contract",
  "type": "object",
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0}
      }
    },
    "capabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_version", "contract_version", "invariant_version", "invariants"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "contract_version": {"const": "1.0.0-alpha.1"},
        "invariant_version": {"type": "string", "minLength": 1},
        "invariants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "operating_systems": {"type": "array", "items": {"enum": ["macos", "windows", "linux", "android"]}, "uniqueItems": true},
        "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "observation_channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "execution_modes": {"type": "array", "items": {"enum": ["background_strict", "foreground_allowed", "sandboxed"]}, "uniqueItems": true},
        "strict_background": {"type": "boolean", "default": false},
        "semantic_input": {"type": "boolean", "default": false},
        "raw_input": {"type": "boolean", "default": false},
        "streaming": {"type": "boolean", "default": false},
        "clipboard": {"type": "boolean", "default": false},
        "shell": {"type": "boolean", "default": false},
        "files": {"type": "boolean", "default": false},
        "audio": {"type": "boolean", "default": false},
        "mobile": {"type": "boolean", "default": false},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "provider_id", "os", "isolation", "state", "capabilities"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "os": {"enum": ["macos", "windows", "linux", "android"]},
        "isolation": {"enum": ["host", "container", "vm"]},
        "state": {"enum": ["creating", "ready", "paused", "stopped", "failed"]},
        "capabilities": {"$ref": "#/$defs/capabilityManifest"},
        "image_digest": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    },
    "environmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "owner_id", "provider_id", "os", "isolation", "state", "created_at", "updated_at", "metadata"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "owner_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "os": {"enum": ["macos", "windows", "linux", "android"]},
        "isolation": {"enum": ["host", "container", "vm"]},
        "state": {"enum": ["requested", "provisioning", "running", "stopping", "stopped", "failed", "destroyed"]},
        "image_digest": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "metadata": {"type": "object"}
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "resource_id", "kind"],
      "properties": {
        "root_id": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "application": {"type": "string"},
        "process_id": {"type": ["integer", "null"]},
        "bounds": {"oneOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "focused": {"type": "boolean"}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role"],
      "properties": {
        "ref": {"type": "string", "pattern": "^@e[1-9][0-9]*$"},
        "role": {"type": "string"},
        "name": {"type": "string"},
        "value": {"type": "string"},
        "description": {"type": "string"},
        "bounds": {"oneOf": [{"$ref": "#/$defs/rect"}, {"type": "null"}]},
        "states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "children": {"type": "array", "items": {"$ref": "#/$defs/element"}},
        "provider_metadata": {"type": "object"}
      }
    },
    "imageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "width", "height", "sha256", "coordinate_space"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "media_type": {"enum": ["image/png", "image/jpeg"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "coordinate_space": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "session_id", "environment_id", "resource_id", "epoch", "captured_at", "provider_id", "provider_version", "roots", "elements"],
      "properties": {
        "state_id": {"type": "string", "pattern": "^state_[a-fA-F0-9]+$"},
        "session_id": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0},
        "captured_at": {"type": "string", "format": "date-time"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "roots": {"type": "array", "items": {"$ref": "#/$defs/root"}},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
        "image": {"oneOf": [{"$ref": "#/$defs/imageEvidence"}, {"type": "null"}]},
        "truncated": {"type": "boolean"},
        "metadata": {"type": "object"}
      }
    },
    "actionTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": ["string", "null"], "pattern": "^@e[1-9][0-9]*$"},
        "x": {"type": ["number", "null"]},
        "y": {"type": ["number", "null"]},
        "root_id": {"type": ["string", "null"]}
      },
      "anyOf": [{"required": ["ref"]}, {"required": ["x", "y"]}, {"required": ["root_id"]}]
    },
    "actionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "target": {"oneOf": [{"$ref": "#/$defs/actionTarget"}, {"type": "null"}]},
        "arguments": {"type": "object"}
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["text", "role", "value", "visible", "focused"]},
        "value": {"type": "string"},
        "gone": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 120000}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "session_id", "environment_id", "resource_id", "base_state_id", "mode", "steps"],
      "properties": {
        "transaction_id": {"type": "string", "pattern": "^tx_[a-fA-F0-9]+$"},
        "session_id": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "base_state_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["background_strict", "foreground_allowed", "sandboxed"]},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actionStep"}},
        "postcondition": {"oneOf": [{"$ref": "#/$defs/postcondition"}, {"type": "null"}]},
        "approval_id": {"type": ["string", "null"]}
      }
    },
    "actionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding", "delivery", "details", "artifact_ids"],
      "properties": {
        "grounding": {"type": "string"},
        "delivery": {"type": "string"},
        "details": {"type": "object"},
        "artifact_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stepOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "status", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["worked", "didnt", "unknown", "blocked", "cancelled"]},
        "evidence": {"$ref": "#/$defs/actionEvidence"},
        "error_code": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      }
    },
    "transactionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "status", "step_outcomes", "stopped_at", "successor_state_id"],
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["worked", "didnt", "unknown", "blocked", "cancelled"]},
        "step_outcomes": {"type": "array", "items": {"$ref": "#/$defs/stepOutcome"}},
        "stopped_at": {"type": ["integer", "null"], "minimum": 0},
        "successor_state_id": {"type": ["string", "null"]},
        "receipt_id": {"type": ["string", "null"]},
        "policy_decision_id": {"type": ["string", "null"]},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "metadata": {"type": "object"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "occurred_at", "session_id", "payload", "contract_version"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "session_id": {"type": "string", "minLength": 1},
        "payload": {"type": "object"},
        "run_id": {"type": ["string", "null"]},
        "state_id": {"type": ["string", "null"]},
        "transaction_id": {"type": ["string", "null"]},
        "trace_id": {"type": ["string", "null"]},
        "contract_version": {"const": "1.0.0-alpha.1"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/capabilityManifest"},
    {"$ref": "#/$defs/environment"},
    {"$ref": "#/$defs/environmentRecord"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/transaction"},
    {"$ref": "#/$defs/transactionOutcome"},
    {"$ref": "#/$defs/event"}
  ]
}
