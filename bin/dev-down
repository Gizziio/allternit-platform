#!/bin/bash
# Stop all allternit launchd services

LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

unload_service() {
    local label="$1"
    local plist="$LAUNCH_AGENTS_DIR/$label.plist"
    if [ -f "$plist" ]; then
        echo "Unloading $label..."
        launchctl unload "$plist" 2>/dev/null || true
    fi
}

unload_service "com.allternit.intent-graph-kernel"
unload_service "com.allternit.presentation-kernel"
unload_service "com.allternit.kernel"
unload_service "com.allternit.shell"
unload_service "com.allternit.ui-tars-operator"

echo "All allternit development services stopped."
