{
  "name": "@allternit/computers",
  "version": "0.1.0",
  "description": "Framework-free TypeScript SDK for the Allternit Computers API (lifecycle, desktop control, file transfer, snapshots, desktop templates)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "keywords": [
    "allternit",
    "computers",
    "cloud-desktop",
    "sdk"
  ],
  "author": "Allternit",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.0.0"
  }
}
