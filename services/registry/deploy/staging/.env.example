# Staging registry secrets. Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=change-me

# MinIO root credentials (also the registry's S3 access key pair in staging;
# production should use a dedicated service account instead)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-long
S3_REGION=us-east-1

# Buckets
MINIAPP_ASSETS_QUARANTINE_BUCKET=miniapp-quarantine
MINIAPP_ASSETS_BUCKET=miniapp-assets
MINIAPP_BACKUP_BUCKET=registry-backups

# Registry API tokens (generate long random values)
MINIAPP_REGISTRY_ADMIN_TOKEN=change-me-admin
MINIAPP_INTAKE_WORKER_TOKEN=change-me-worker

# Approvals require the full intake pipeline to report awaiting_review.
# Set to 0 in early staging to allow manual approval without pipeline evidence.
MINIAPP_INTAKE_ENFORCE=1

# TLS + backups
REGISTRY_TLS_PORT=8443
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
