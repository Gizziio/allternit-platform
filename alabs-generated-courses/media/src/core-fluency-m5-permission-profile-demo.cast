{"version": 2, "width": 80, "height": 16, "timestamp": 1700000000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.0, "o", "\u001b[1;32m$\u001b[0m gizzi config permission-profiles diff restricted trusted-review\r\n"]
[0.8, "o", "approval_policy: untrusted -> on-request\r\nsandbox_mode: restricted -> workspace-write\r\nnetwork_access: false -> true (approval required)\r\n"]
[2.0, "o", "\u001b[1;32m$\u001b[0m export DISABLE_TELEMETRY=1\r\n"]
[2.5, "o", "\u001b[1;32m$\u001b[0m gizzi --profile restricted exec \"Review public PR diff\"\r\n"]
[3.5, "o", "\u001b[90m→\u001b[0m Network access denied by profile\r\n"]
[4.2, "o", "\u001b[90m→\u001b[0m Filesystem writes require approval\r\n"]
[5.0, "o", "\u001b[1;32m✓\u001b[0m No external data exfiltration path in restricted mode.\r\n"]
