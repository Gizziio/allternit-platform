{"version": 2, "width": 80, "height": 24, "timestamp": 1758450000, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.000000, "o", "$ cat harness-stream.ts\r\n"]
[0.800000, "o", "import { AllternitHarness } from '@allternit/sdk';\r\n\r\n"]
[1.200000, "o", "const harness = new AllternitHarness({\r\n"]
[1.400000, "o", "  mode: 'byok',\r\n"]
[1.600000, "o", "  byok: { openai: { apiKey: process.env.OPENAI_API_KEY! } },\r\n"]
[1.800000, "o", "  middleware: {\r\n"]
[2.000000, "o", "    beforeRequest: async (req) => {\r\n"]
[2.200000, "o", "      console.log('[middleware] provider:', req.provider, 'model:', req.model);\r\n"]
[2.400000, "o", "      return req;\r\n"]
[2.600000, "o", "    }\r\n"]
[2.800000, "o", "  }\r\n"]
[3.000000, "o", "});\r\n\r\n"]
[3.500000, "o", "const stream = harness.stream({\r\n"]
[3.700000, "o", "  provider: 'openai',\r\n"]
[3.900000, "o", "  model: 'gpt-4o',\r\n"]
[4.100000, "o", "  messages: [{ role: 'user', content: 'Count to 5' }],\r\n"]
[4.300000, "o", "});\r\n\r\n"]
[4.500000, "o", "for await (const chunk of stream) {\r\n"]
[4.700000, "o", "  if (chunk.type === 'text') process.stdout.write(chunk.text);\r\n"]
[4.900000, "o", "  if (chunk.type === 'done') console.log('\r\n', chunk.usage);\r\n"]
[5.100000, "o", "}\r\n"]
[5.800000, "o", "$ npx tsx harness-stream.ts\r\n"]
[6.500000, "o", "[middleware] provider: openai model: gpt-4o\r\n"]
[7.200000, "o", "1"]
[7.350000, "o", " " ]
[7.500000, "o", "2"]
