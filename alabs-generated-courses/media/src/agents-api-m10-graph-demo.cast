{"version": 2, "width": 80, "height": 24, "timestamp": 1758451000, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.000000, "o", "$ cat run-support-workflow.ts\r\n"]
[0.800000, "o", "import { createWorkflowEngine } from '@allternit/workflow-engine';\r\n\r\n"]
[1.200000, "o", "const engine = createWorkflowEngine();\r\n\r\n"]
[1.500000, "o", "engine.registerWorkflow({\r\n"]
[1.700000, "o", "  id: 'support-triage',\r\n"]
[1.900000, "o", "  name: 'Support ticket triage',\r\n"]
[2.100000, "o", "  version: '1.0.0',\r\n"]
[2.300000, "o", "  nodes: [\r\n"]
[2.500000, "o", "    { id: 'trigger', type: 'trigger:manual', name: 'Start' },\r\n"]
[2.700000, "o", "    { id: 'classify', type: 'condition:if', name: 'Classify',\r\n"]
[2.900000, "o", "      config: { condition: 'data.sentiment === \"negative\"' } },\r\n"]
[3.100000, "o", "    { id: 'draft', type: 'output:result', name: 'Draft reply' },\r\n"]
[3.300000, "o", "    { id: 'escalate', type: 'output:result', name: 'Escalate' },\r\n"]
[3.500000, "o", "  ],\r\n"]
[3.700000, "o", "  connections: [\r\n"]
[3.900000, "o", "    { id: 'c1', source: 'trigger', target: 'classify' },\r\n"]
[4.100000, "o", "    { id: 'c2', source: 'classify', sourcePort: 'true', target: 'escalate' },\r\n"]
[4.300000, "o", "    { id: 'c3', source: 'classify', sourcePort: 'false', target: 'draft' },\r\n"]
[4.500000, "o", "  ],\r\n"]
[4.700000, "o", "});\r\n\r\n"]
[5.200000, "o", "const result = await engine.execute('support-triage', {\r\n"]
[5.400000, "o", "  sentiment: 'negative',\r\n"]
[5.600000, "o", "  body: 'Dashboard keeps timing out.'\r\n"]
[5.800000, "o", "});\r\n\r\n"]
[6.200000, "o", "console.log(result.status, result.outputs);\r\n"]
[7.000000, "o", "$ npx tsx run-support-workflow.ts\r\n"]
[8.000000, "o", "running\r\n"]
[8.500000, "o", "completed\r\n"]
[9.000000, "o", "{ 'output:result': { message: 'Escalate' } }\r\n"]
[10.000000, "o", "$ " ]
