{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://allternit.com/schemas/Ticket.json",
  "title": "Ticket",
  "description": "A Rails ticket — the primary unit of tracked work. Equivalent to a Beads issue.",
  "type": "object",
  "required": ["id", "hierarchical_id", "title", "description", "status", "kind", "priority", "labels", "metadata", "created_at", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Canonical hash-based ticket identifier, e.g. T-a1b2c3d4...",
      "pattern": "^T-[0-9a-f]{32}$"
    },
    "hierarchical_id": {
      "type": "string",
      "description": "Hierarchical identifier with dotted children, e.g. T-a1b2.1.2",
      "pattern": "^T-[0-9a-f]{32}(\\.\\d+)*$"
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "design": { "type": ["string", "null"] },
    "acceptance": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "blocked", "deferred", "closed"]
    },
    "kind": {
      "type": "string",
      "enum": ["task", "bug", "feature", "epic", "chore", "decision"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "P4"]
    },
    "assignee": { "type": ["string", "null"] },
    "estimate_minutes": { "type": ["integer", "null"] },
    "due_at": { "type": ["string", "null"], "format": "date-time" },
    "defer_until": { "type": ["string", "null"], "format": "date-time" },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "external_ref": { "type": ["string", "null"] },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "close_reason": { "type": ["string", "null"] },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/definitions/TicketNote" }
    }
  },
  "definitions": {
    "TicketNote": {
      "type": "object",
      "required": ["id", "author", "body", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "body": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
